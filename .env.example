CITYLINE_BRIDGE_TOKEN=replace-with-a-random-token-generated-by-npm-run-init
CITYLINE_PORT=8787
CITYLINE_DATA_DIR=.data
CITYLINE_PROFILE_PATH=config/cityline.local.json
CITYLINE_ALLOW_LIVE=false
# Only set after explicitly configuring your own authenticated HTTPS reverse proxy.
# CITYLINE_PUBLIC_ORIGIN=https://your-own-host.example
# PLAYWRIGHT_MODULE_PATH=/absolute/path/to/playwright/index.mjs
